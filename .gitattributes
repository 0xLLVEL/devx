# Normalise line endings in the repository, check out native on Windows.
* text=auto

# Files whose content is byte-sensitive or line-ending-sensitive.
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# Windows-only scripts must keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.icns binary
